{
  "name": "cluster-loaders",
  "version": "1.0.1",
  "description": "Physics-driven, parametric & dither-shader SVG/Canvas loaders for React. Powered by FS Cluster & Torus Founding Space.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
